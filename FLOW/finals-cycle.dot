digraph finals_cycle {
    rankdir=TB;
    node [fontname="Arial", fontsize=11];
    edge [fontname="Arial", fontsize=10];
    bgcolor="transparent";

    // =============================
    // FINALES MONITORING + UPDATE CYCLE
    // Automated (worker.js) + Agent (opencode)
    // =============================

    // ── PHASE 1: AUTOMATED MONITORING (worker.js cron) ──

    cron_start [shape=ellipse, style=filled, fillcolor="#22c55e", fontcolor=white, label="CRON TRIGGER\nworker.js scheduled()\n1° e 15° de cada mês\n12:00 UTC"];

    fetch_html [shape=box, style=filled, fillcolor="#22d3ee", label="FETCH TABELA HTML\n\nURL PRIMÁRIA:\nmed.unlp.edu.ar/index.php/\nestudiantes/fechas-de-finales\n?catid=441&id=1018&view=article\n\n→ fetch() via Cloudflare Worker\n→ retorna tabela HTML com\n  colunas: Cátedra | Ago | Sep | Oct | Nov | Dic\n\nCOMPLEMENTAR:\n• PDF oficial (quando disponível)\n  med.unlp.edu.ar/images/noticias/2026/finales/\n• Cartelera (verificação por cátedra)\n  cartelera.med.unlp.edu.ar/catedra/N"];

    parse_html [shape=box, style=filled, fillcolor="#a855f7", fontcolor=white, label="PARSEAR HTML\n\nparseFinalesHtml(html):\n1. Split por <tr> rows\n2. Extrair <td class='asig'> → nome matéria\n3. Extrair cells DD/MM → fecha YYYY-MM-DD\n4. Ignorar '- - -' (sem exame)\n5. Converter entidades HTML (á, é, í, ó, ú, ñ)\n6. Retornar Map<nome, [{fecha, label}]>"];

    load_snapshot [shape=box, style=filled, fillcolor="#6366f1", fontcolor=white, label="CARREGAR SNAPSHOT\n\nKV: CARTELERA_SUBS\nKey: 'finale-snapshot'\n→ { hash, data }\n\nSe null → primeira execução\n→ salvar snapshot + sair"];

    compare [shape=diamond, style=filled, fillcolor="#facc15", label="COMPARAR HASHES\n\ncomputeFinalesHash(novo)\nvs snapshot.hash\n\nIguais?"];

    diff [shape=box, style=filled, fillcolor="#f59e0b", fontcolor=black, label="DIFF DETALHADO\n\ndiffFinales(old, novo):\n• added: matérias novas\n• modified: datas alteradas\n  (old → new)\n• removed: matérias removidas"];

    send_email [shape=box, style=filled, fillcolor="#ef4444", fontcolor=white, label="ENVIAR EMAIL ADMIN\n\nPara: felipetesta@gmail.com\nAssunto: 📋 Fechas de Finales\n         - Actualización detectada\n\nCorpo HTML com:\n✅ Adicionadas  ⚠️ Modificadas\n❌ Removidas\n+ link tabela oficial\n+ link PDF oficial"];

    save_snapshot [shape=box, style=filled, fillcolor="#22c55e", fontcolor=white, label="SALVAR NOVO SNAPSHOT\n\nKV.put('finale-snapshot',\n  { hash: novoHash, data: novoData })\n\nTTL: sem expiração"];

    cron_end [shape=ellipse, style=filled, fillcolor="#94a3b8", fontcolor=white, label="FIM CRON\nPróxima verificação:\n15° do mês ou 1° do próximo"];

    no_change [shape=ellipse, style=filled, fillcolor="#94a3b8", fontcolor=white, label="SEM MUDANÇAS\nLog: 'no changes detected'\nFim do ciclo"];

    // ── PHASE 2: AGENT UPDATE (opencode) ──

    agent_trigger [shape=ellipse, style=filled, fillcolor="#22c55e", fontcolor=white, label="AGENTE DISPARADO\n\nUsuário diz: 'atualizar finales'\nOU email de notificação recebido\n→ Agente entra em build mode"];

    read_snapshot [shape=box, style=filled, fillcolor="#6366f1", fontcolor=white, label="LER SNAPSHOT ATUAL\n\n1. Ler KV 'finale-snapshot'\n   → dados novos da tabela HTML\n2. Ler APP/finales/finales.json\n   → dados atuais do site\n3. Comparar: o que mudou?"];

    cross_reference [shape=box, style=filled, fillcolor="#a855f7", fontcolor=white, label="CROSS-REFERENCIAR\n\nPara cada matéria no snapshot:\n• Código em materias.js?\n  (buscar por nome → código)\n• Cátedras correspondem?\n  Regular/Libre corretos?\n• Datas anteriores a hoje?\n  → remover (regra 3 dias)"];

    retention [shape=box, style=filled, fillcolor="#f59e0b", fontcolor=black, label="REGRA DE RETENÇÃO DE DATAS\n\n• Remover datas com > 365 dias no passado\n  (ex: hoje=05/09/2026, manter ≥ 05/09/2025)\n• Manter TODAS as datas futuras (sem limite)\n• Preservar histórico de cátedras no ano corrente"];

    plan_changes [shape=box, style=filled, fillcolor="#f59e0b", fontcolor=black, label="PLANEJAR MUDANÇAS\n\nPara cada diferença:\n• Adicionar nova matéria?\n  → verificar código em materias.js\n• Datas alteradas?\n  → atualizar array de fechas\n• Nova cátedra?\n  → adicionar entrada\n• Removida?\n  → remover entrada\n\nAplicar regras:\n• Regular/Libre split correto\n• Sem duplicatas\n• Formato ISO YYYY-MM-DD"];

    edit_finales [shape=box, style=filled, fillcolor="#f97316", fontcolor=white, label="EDITAR finales.json\n\nUsar edit tool:\n• Substituir blocos de datas\n• Adicionar/remover cátedras\n• Manter estrutura existente\n\nNUNCA: new Function, eval, etc."];

    validate_json [shape=diamond, style=filled, fillcolor="#facc15", label="JSON VÁLIDO?\n\nnode -e 'JSON.parse(...)'\n\nOK?"];

    review_logic [shape=box, style=filled, fillcolor="#22d3ee", label="REVISAR app.js\n\nVerificar:\n• obtenerProximasFechas()\n  filtra corretamente?\n• toggle Regular/Libre\n  funciona com novos nomes?\n• Dedup de datas não quebrou?\n• 3-day filter ativo?"];

    deploy [shape=box, style=filled, fillcolor="#22c55e", fontcolor=white, label="DEPLOY\n\ngit add + commit + push\n→ Cloudflare Pages deploy\n→ deploy.ps1 (bump version.json)\n→ Verificar em produção"];

    update_log [shape=box, style=filled, fillcolor="#6366f1", fontcolor=white, label="ATUALIZAR DOCUMENTAÇÃO\n\n• LOG.md: adicionar entrada\n  Fixed/Changed + data\n• AGENTS.md: IMPLEMENT section\n• commit separado"];

    agent_end [shape=ellipse, style=filled, fillcolor="#94a3b8", fontcolor=white, label="FIM DO CICLO\n\nPróxima verificação:\n15° do mês (automático)\nOU próximo pedido do usuário"];

    // ── ERROR HANDLING ──

    fetch_error [shape=box, style=filled, fillcolor="#ef4444", fontcolor=white, label="ERRO DE FETCH\n\n• Site fora do ar?\n• URL mudou?\n• Timeout?\n\n→ Log erro\n→ Email admin com detalhes\n→ Retry no próximo ciclo"];

    parse_error [shape=box, style=filled, fillcolor="#ef4444", fontcolor=white, label="ERRO DE PARSE\n\n• HTML structure mudou?\n• Tags diferentes?\n\n→ Log erro + HTML recebido\n→ Email admin com diff\n→ Ajustar parseFinalesHtml()"];

    json_error [shape=box, style=filled, fillcolor="#ef4444", fontcolor=white, label="ERRO JSON\n\n• Corrigir sintaxe\n• Re-validar\n• Re-ler finales.json\n→ Voltar para editar"];

    prod_error [shape=box, style=filled, fillcolor="#ef4444", fontcolor=white, label="ERRO EM PRODUÇÃO\n\n• Verificar console browser (F12)\n• Conferir path do JSON\n• Reverter commit se necessário\n→ Voltar para editar"];

    // ── PHASE 1 FLOW ──
    cron_start -> fetch_html;
    fetch_html -> parse_html;
    fetch_html -> fetch_error [label="ERRO"];
    fetch_error -> cron_end;
    parse_html -> load_snapshot;
    parse_html -> parse_error [label="ERRO"];
    parse_error -> cron_end;
    load_snapshot -> compare;
    compare -> no_change [label="IGUAIS"];
    no_change -> cron_end;
    compare -> diff [label="DIFERENTES"];
    diff -> send_email;
    send_email -> save_snapshot;
    save_snapshot -> cron_end;

    // ── PHASE 2 FLOW ──
    agent_trigger -> read_snapshot;
    read_snapshot -> cross_reference;
    cross_reference -> retention;
    retention -> plan_changes;
    plan_changes -> edit_finales;
    edit_finales -> validate_json;
    validate_json -> review_logic [label="OK"];
    validate_json -> json_error [label="ERRO"];
    json_error -> edit_finales;
    review_logic -> deploy;
    deploy -> update_log;
    update_log -> agent_end;
    deploy -> prod_error [label="ERRO"];
    prod_error -> edit_finales;

    // ── NOTES ──

    freq_note [shape=note, label="FREQUÊNCIA:\n\nAutomático: 1° e 15° de cada mês\nManual: a cada 2 semanas (verificar)\nUrgente: usuário reporta erro"];
    sources_note [shape=note, label="FONTES:\n\n1. med.unlp.edu.ar (HTML table)\n   → fonte primária\n2. PDF oficial (complementar)\n   → quando disponível\n3. Cartelera (verificação)\n   → confirmação por cátedra"];
    kv_note [shape=note, label="KV STORAGE:\n\nfinale-snapshot:\n  { hash: string, data: Map }\n  → armazena último scrape\n  → compara no próximo ciclo\n  → TTL: sem expiração"];
    retention_note [shape=note, label="REGRA DE RETENÇÃO:\n\n• Remover datas > 365 dias passado\n• Manter todas futuras\n• Preservar ano corrente"];

    cron_start -> freq_note [style=dotted];
    fetch_html -> sources_note [style=dotted];
    load_snapshot -> kv_note [style=dotted];
    retention -> retention_note [style=dotted];
}
